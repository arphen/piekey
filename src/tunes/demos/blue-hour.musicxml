  <work><work-title>Blue Hour</work-title></work>
  <identification>
    <creator type="composer">Fretboard Focus Lab</creator>
    <rights>Original study for Fretboard Focus Lab. SPDX-License-Identifier: AGPL-3.0-only.</rights>
    <miscellaneous>
      <miscellaneous-field name="provenance">Original melody and arrangement created for this project; no third-party score or recording used.</miscellaneous-field>
      <miscellaneous-field name="practice-notes">Twelve-bar C jazz blues, played twice. Even eighths. Sounding range C3–C4, playable in frets 5–8.</miscellaneous-field>
    </miscellaneous>
  </identification>
